
{
  "expo": {
    "name": "Frase del Día",
    "slug": "frase-del-dia",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "frasedeldia",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7FB"
      },
      "package": "com.tunombre.frasedeldia"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF7FB"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba50bae6-cfae-481b-8ef8-6aa2beca9a8c"
      }
    }
  }
}
